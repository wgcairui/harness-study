# Copy to .env.local and fill in real values.
# Bun auto-loads .env / .env.local — no need to import dotenv.

# Anthropic-protocol endpoint. Any baseURL whose target speaks the
# Anthropic Messages API works (GLM-5 / glm-5-turbo / Claude / MiniMax-M3).
ANTHROPIC_BASE_URL=https://zcode.z.ai/api/v1/zcode-plan/anthropic

# Provider API key (read from env only — never read ~/.zcode/ credentials)
ANTHROPIC_API_KEY=put-your-key-here

# Model id to send in `model:` field.
HARNESS_MODEL=GLM-5

# Cap on assistant turns before the loop forces exit.
HARNESS_MAX_TURNS=8
